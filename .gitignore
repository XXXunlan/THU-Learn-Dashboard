# 依赖（本项目零依赖，列在这里是防止以后误装）
node_modules/

# ---------------------------------------------------------------
# 扩展私钥：绝对不要提交。
#   manifest.json 里的 "key" 是**公钥**，公开没问题 —— 它就是用来固定扩展 ID 的。
#   但配套的私钥一旦泄露，别人就能冒充你发布这个扩展的更新。
#   tools/gen-key.mjs 只把私钥打到屏幕上、不写文件；如果你曾重定向存过文件，
#   请把它放在仓库之外并单独备份（丢了就再也发不了同一个 ID 的更新）。
# ---------------------------------------------------------------
*.pem
*.key
*.pfx
*.p12
*.p8
*.jks
*.keystore

# ---------------------------------------------------------------
# 诊断包与取证产物：里面有真实的课程、教师、姓名与接口响应。
#   这类文件是用来排查问题的，永远不该进版本库。
# ---------------------------------------------------------------
thu-learn-diagnostics-*.json
thu-learn-forensics-*.json
yuketang-forensics-*.json
*-forensics-*.json
*.har
*.snapshot.html

# ---------------------------------------------------------------
# 账密 / 环境
# ---------------------------------------------------------------
.env
.env.*
*.local

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
