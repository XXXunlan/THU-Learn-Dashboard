{
  "manifest_version": 3,
  "name": "THU Learn Dashboard · 网络学堂 × 雨课堂",
  "short_name": "网络学堂×雨课堂",
  "version": "2.0.1",
  "description": "把清华大学网络学堂与雨课堂的作业合并到一块面板：公告、文件、作业（含截止倒计时）按课程汇总，雨课堂作业自动归入同名课程，一键跳转到对应页面。",
  "minimum_chrome_version": "111",
  "key": "",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "网络学堂 × 雨课堂",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "offscreen",
    "scripting"
  ],

  "host_permissions": [
    "https://learn.tsinghua.edu.cn/*"
  ],

  "optional_host_permissions": [
    "https://*.tsinghua.edu.cn/*",
    "https://*.yuketang.cn/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://learn.tsinghua.edu.cn/*"],
      "js": ["src/content/sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://learn.tsinghua.edu.cn/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://learn.tsinghua.edu.cn/*"]
    }
  ]
}
